---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.short} description={d.summary} ogType="article">
  <article class="page">
    <a class="back" href="/#projects">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M14 8H3M7 4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      Back
    </a>
    <h1 class="page-title">{d.title}</h1>
    <p class="page-lede">{d.summary}</p>

    <dl class="meta">
      {d.role && <><dt>Role</dt><dd>{d.role}</dd></>}
      <dt>Context</dt><dd>{d.context}</dd>
      {d.period && <><dt>Period</dt><dd>{d.period}</dd></>}
      <dt>Status</dt><dd>{d.status}</dd>
      {d.links.length > 0 && (
        <>
          <dt>Links</dt>
          <dd class="links">{d.links.map((l) => <a class="inline-link wrap-ok" href={l.href}>{l.label}</a>)}</dd>
        </>
      )}
    </dl>
    {d.stack.length > 0 && (
      <ul class="tags" aria-label="Stack">
        {d.stack.map((s) => <li>{s}</li>)}
      </ul>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="next">
      <span>Next project</span>
      <a class="inline-link" href={`/work/${next.id}/`}>{next.data.short}</a>
    </footer>
  </article>
</Base>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .prose { margin-top: 8px; }
  .next { display: flex; gap: 10px; align-items: baseline; margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
</style>
