---
// Arrowhead marker defs, one per SVG. Use marker-end="url(#<id>-h)".
interface Props { id: string }
const { id } = Astro.props;
---
<defs>
  <marker id={`${id}-h`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
    <path d="M0 0L10 5L0 10z" class="dg-head" />
  </marker>
  <marker id={`${id}-hh`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
    <path d="M0 0L10 5L0 10z" class="dg-head-hi" />
  </marker>
</defs>
