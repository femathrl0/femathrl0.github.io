---
import Arrow from './Arrow.astro';
const id = 'mn-arch';
const rows = [
  'PostgreSQL 17 · RLS on every table',
  'Auth · Google OAuth',
  'Storage · private, signed URLs',
  'Edge Functions · Deno 2',
  'pg_cron · scheduled jobs',
];
---
<svg viewBox="0 0 800 330" role="img" aria-labelledby={`${id}-t ${id}-d`}>
  <title id={`${id}-t`}>Macronutri architecture</title>
  <desc id={`${id}-d`}>The browser runs a React single-page app served by Cloudflare Workers. It talks to Supabase over HTTPS with a JWT. Supabase holds PostgreSQL 17 with row level security on every table, Auth with Google OAuth, private Storage with signed URLs, Edge Functions on Deno 2, and pg_cron jobs. Edge Functions call an LLM API with pseudonymized data only, receive signed payment webhooks from Asaas, and send email through Resend.</desc>
  <Arrow id={id} />

  <rect class="dg-box" x="20" y="117" width="170" height="96" />
  <text class="dg-t" x="36" y="147">Browser</text>
  <text class="dg-s" x="36" y="169">React 19 SPA · PWA</text>
  <text class="dg-m" x="36" y="193">TanStack Query · Zod</text>
  <text class="dg-m" x="20" y="236">served by Cloudflare Workers</text>

  <line class="dg-line" x1="190" y1="165" x2="268" y2="165" marker-end={`url(#${id}-h)`} />
  <text class="dg-m" x="196" y="156">HTTPS+JWT</text>

  <rect class="dg-box-hi" x="270" y="20" width="250" height="290" />
  <text class="dg-t" x="286" y="46">Supabase</text>
  <text class="dg-m" x="286" y="65">São Paulo · staging + production</text>
  {rows.map((r, i) => (
    <g>
      <rect class="dg-box" x="286" y={80 + i * 46} width="218" height="38" />
      <text class="dg-s" x="298" y={104 + i * 46}>{r}</text>
    </g>
  ))}

  <line class="dg-line" x1="520" y1="100" x2="618" y2="100" marker-end={`url(#${id}-h)`} />
  <text class="dg-m" x="528" y="91">AI calls</text>
  <line class="dg-line" x1="522" y1="200" x2="620" y2="200" marker-start={`url(#${id}-h)`} />
  <text class="dg-m" x="528" y="191">webhook</text>
  <line class="dg-line" x1="520" y1="285" x2="618" y2="285" marker-end={`url(#${id}-h)`} />
  <text class="dg-m" x="528" y="276">email</text>

  <rect class="dg-box" x="620" y="70" width="160" height="60" />
  <text class="dg-t" x="634" y="96">LLM API</text>
  <text class="dg-s" x="634" y="117">pseudonymized data only</text>
  <rect class="dg-box" x="620" y="170" width="160" height="60" />
  <text class="dg-t" x="634" y="196">Asaas</text>
  <text class="dg-s" x="634" y="217">payments</text>
  <rect class="dg-box" x="620" y="255" width="160" height="60" />
  <text class="dg-t" x="634" y="281">Resend</text>
  <text class="dg-s" x="634" y="302">transactional email</text>
</svg>
