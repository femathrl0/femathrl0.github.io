---
import Arrow from './Arrow.astro';
const id = 'mn-ci';
const jobs = ['unit', 'deno', 'rls', 'npm audit', 'osv-scanner', 'gitleaks', 'docker', 'wrangler', 'visual'];
---
<svg viewBox="0 0 930 270" role="img" aria-labelledby={`${id}-t ${id}-d`}>
  <title id={`${id}-t`}>CI/CD pipeline</title>
  <desc id={`${id}-d`}>A git push runs nine CI jobs: unit, deno, rls, npm audit, osv-scanner, gitleaks, docker, wrangler and visual. Every green push deploys to staging automatically. Production deploys are manual, behind a confirmation gate with a pre-deploy backup. A global DEPLOY_ENABLED kill switch governs both deploys. A scheduled workflow makes daily encrypted backups.</desc>
  <Arrow id={id} />

  <rect class="dg-box" x="20" y="100" width="100" height="56" />
  <text class="dg-t" x="34" y="133">git push</text>
  <line class="dg-line" x1="120" y1="128" x2="148" y2="128" marker-end={`url(#${id}-h)`} />

  <rect class="dg-box" x="150" y="60" width="280" height="136" />
  <text class="dg-t" x="166" y="86">CI · 9 jobs</text>
  {jobs.map((j, i) => (
    <text class="dg-m" x={166 + (i % 3) * 90} y={116 + Math.floor(i / 3) * 24}>{j}</text>
  ))}
  <line class="dg-line" x1="430" y1="128" x2="478" y2="128" marker-end={`url(#${id}-h)`} />
  <text class="dg-m" x="435" y="119">green</text>

  <rect class="dg-line dg-dash" x="474" y="36" width="448" height="160" />
  <text class="dg-a" x="482" y="62">DEPLOY_ENABLED · global kill switch</text>

  <rect class="dg-box" x="480" y="100" width="120" height="56" />
  <text class="dg-t" x="494" y="125">Staging</text>
  <text class="dg-m" x="494" y="144">automatic</text>
  <line class="dg-line" x1="600" y1="128" x2="628" y2="128" marker-end={`url(#${id}-h)`} />

  <rect class="dg-box" x="630" y="88" width="150" height="80" />
  <text class="dg-t" x="644" y="113">Manual gate</text>
  <text class="dg-s" x="644" y="134">confirmation +</text>
  <text class="dg-s" x="644" y="152">pre-deploy backup</text>
  <line class="dg-line-hi" x1="780" y1="128" x2="798" y2="128" marker-end={`url(#${id}-hh)`} />

  <rect class="dg-box-hi" x="800" y="100" width="110" height="56" />
  <text class="dg-t" x="814" y="133">Production</text>

  <text class="dg-s" x="20" y="240">Scheduled separately: daily encrypted backups (age).</text>
</svg>
